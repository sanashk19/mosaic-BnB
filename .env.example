# ── MOSAIC ENVIRONMENT CONFIGURATION ──────────────────────────────────────

# Authentication session secret (Minimum 32 random characters for production)
SESSION_SECRET=replace-with-a-secure-random-secret-key-for-production
UQUVLI_SESSION_SECRET=replace-with-a-secure-random-secret-key-for-production

# ISL Recognition Service URL
# Local Development: http://127.0.0.1:8000
# Production / Railway: https://your-fastapi-service.up.railway.app
ISL_BACKEND_URL=http://127.0.0.1:8000
ISL_API_URL=http://127.0.0.1:8000

# Persistent Data Storage Path (Optional, for persistent container volumes)
# Defaults to data/uquvli-db.json in project root
DATA_DIR=/app/data
UQUVLI_DB_PATH=/app/data/uquvli-db.json

# AWS Bedrock Configuration (Optional for cloud ISL sentence grammar formatting)
# If omitted, Mosaic automatically uses the deterministic local rule fallback
AWS_DEFAULT_REGION=ap-south-1
AWS_BEDROCK_MODEL_ARN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
