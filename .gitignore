# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.data/
/data/*
!/data/.gitkeep
!/data/demo-seed.example.json

# production
/build

# misc
.DS_Store
*.pem
_server/
SERVER_ACCESS.md
SSH_ACCESS.txt
SSH_PASSWORD.txt
.playwright-cli/
.playwright-mcp/
__pycache__/
*.pyc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
